# ==========================================
# API Forge - Variables de Entorno (Fase 0)
# ==========================================
# Copia este archivo como .env para desarrollo local:
# cp .env.example .env

# Configuración del Servidor Express
PORT=3000
HOST="0.0.0.0"
NODE_ENV="development"

# Base de Datos SQLite Local
# Formato compatible con @libsql/client y Drizzle ORM:
# - Archivo local: file:api_forge.db o file:data/api_forge.db
# - Memoria (tests): file::memory: o :memory:
DATABASE_URL="file:api_forge.db"

# Nivel de registro (debug | info | warn | error)
LOG_LEVEL="info"
